{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloverapps.ai/schemas/clover-project-policy-1.2.0.json",
  "title": "Clover Project Policy 1.2.0 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "project",
    "execution",
    "commands",
    "browserAudit",
    "authority"
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args"],
      "properties": {
        "executable": {
          "enum": ["npm", "pnpm", "yarn", "bun"]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000\\r\\n;&|<>`$]*$"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.2" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "const": "1.2.0" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "repository", "class", "productionBranch", "productionUrl"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "class": {
          "enum": [
            "static-public",
            "public-read-mostly",
            "authenticated-read-mostly",
            "data-backed",
            "payment",
            "messaging",
            "waiver",
            "legal-evidence"
          ]
        },
        "productionBranch": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        "productionUrl": { "type": "string", "format": "uri" },
        "vercelProjectId": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowedBranchPrefixes", "allowedChangePaths", "sensitivePaths", "forbiddenCapabilities"],
      "properties": {
        "mode": { "const": "preview-only" },
        "allowedBranchPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
        },
        "allowedChangePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._/*?-]+$" }
        },
        "sensitivePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._/*?-]+$" }
        },
        "forbiddenCapabilities": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "merge",
              "production-deploy",
              "production-data-write",
              "domain-or-dns-change",
              "secret-change",
              "external-message",
              "purchase"
            ]
          },
          "allOf": [
            { "contains": { "const": "merge" } },
            { "contains": { "const": "production-deploy" } },
            { "contains": { "const": "production-data-write" } },
            { "contains": { "const": "domain-or-dns-change" } },
            { "contains": { "const": "secret-change" } },
            { "contains": { "const": "external-message" } },
            { "contains": { "const": "purchase" } }
          ]
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "verify", "preview"],
      "properties": {
        "install": { "$ref": "#/$defs/command" },
        "verify": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/command" }
        },
        "preview": { "$ref": "#/$defs/command" }
      }
    },
    "browserAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "profiles", "routes", "budgets"],
      "properties": {
        "baseUrl": { "type": "string", "format": "uri", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/?$" },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "browser", "width", "height"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
              "browser": { "enum": ["chromium", "webkit"] },
              "width": { "type": "integer", "minimum": 320, "maximum": 3000 },
              "height": { "type": "integer", "minimum": 480, "maximum": 4000 },
              "deviceScaleFactor": { "type": "number", "minimum": 1, "maximum": 4 },
              "isMobile": { "type": "boolean" },
              "hasTouch": { "type": "boolean" }
            }
          }
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
              "path": { "type": "string", "pattern": "^/(?!/)[^\\\\\\r\\n]*$" },
              "requiredSelectors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "requiredText": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "waitForSelector": { "type": "string", "minLength": 1 },
              "waitForText": { "type": "string", "minLength": 1 }
            }
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxConsoleErrors", "maxPageErrors", "maxFirstPartyRequestFailures", "maxHttpErrors", "maxBrokenImages", "maxHorizontalOverflowPx"],
          "properties": {
            "maxConsoleErrors": { "type": "integer", "minimum": 0 },
            "maxPageErrors": { "type": "integer", "minimum": 0 },
            "maxFirstPartyRequestFailures": { "type": "integer", "minimum": 0 },
            "maxHttpErrors": { "type": "integer", "minimum": 0 },
            "maxBrokenImages": { "type": "integer", "minimum": 0 },
            "maxHorizontalOverflowPx": { "type": "integer", "minimum": 0 },
            "maxDuplicateIds": { "type": "integer", "minimum": 0 },
            "maxUnlabeledControls": { "type": "integer", "minimum": 0 }
          }
        },
        "ignoreConsolePatterns": { "type": "array", "items": { "type": "string" } },
        "ignoreRequestPatterns": { "type": "array", "items": { "type": "string" } },
        "stabilizationMs": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mergeApproved",
        "productionDeploymentApproved",
        "productionDataMutationApproved",
        "domainOrDnsChangeApproved",
        "secretChangeApproved",
        "externalMessageApproved",
        "purchaseApproved"
      ],
      "properties": {
        "mergeApproved": { "const": false },
        "productionDeploymentApproved": { "const": false },
        "productionDataMutationApproved": { "const": false },
        "domainOrDnsChangeApproved": { "const": false },
        "secretChangeApproved": { "const": false },
        "externalMessageApproved": { "const": false },
        "purchaseApproved": { "const": false }
      }
    }
  }
}
