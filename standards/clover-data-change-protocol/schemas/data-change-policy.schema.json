{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloverapps.ai/schemas/clover-data-change-policy-1.0.0.json",
  "title": "Clover Data Change Policy 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "project",
    "source",
    "execution",
    "commands",
    "database",
    "authority"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "repository",
        "commit"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "repository": {
          "const": "chrisdortch/first"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "repository",
        "class",
        "productionBranch"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "class": {
          "enum": [
            "database-backed",
            "payment-data",
            "waiver-records",
            "legal-evidence",
            "operational-state"
          ]
        },
        "productionBranch": {
          "type": "string",
          "minLength": 1
        },
        "productionUrl": {
          "type": "string"
        },
        "vercelProjectId": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineCommit",
        "productionCommitAtEnrollment"
      ],
      "properties": {
        "baselineCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "productionCommitAtEnrollment": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allowedBranchPrefixes",
        "allowedChangePaths",
        "sensitivePaths",
        "forbiddenEnvironmentVariables",
        "forbiddenCapabilities"
      ],
      "properties": {
        "mode": {
          "const": "disposable-database-only"
        },
        "allowedBranchPrefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedChangePaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sensitivePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbiddenEnvironmentVariables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          }
        },
        "forbiddenCapabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "production-database-read",
              "production-database-write",
              "production-migration",
              "production-backup-or-restore",
              "merge",
              "production-deploy-or-promotion",
              "domain-or-dns-change",
              "secret-change",
              "external-message",
              "purchase"
            ]
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install",
        "verify"
      ],
      "properties": {
        "install": {
          "const": "npm ci"
        },
        "verify": {
          "oneOf": [
            {
              "const": "npm test"
            },
            {
              "type": "string",
              "pattern": "^npm run [A-Za-z0-9:_-]+$"
            }
          ]
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "majorVersion",
        "disposableDatabaseName",
        "allowedTablePrefixes",
        "baselineSqlPath",
        "seedSqlPath",
        "forwardSqlPath",
        "assertionsSqlPath",
        "reconciliationSqlPath",
        "rollbackSqlPath",
        "postRollbackAssertionsSqlPath",
        "requireForwardIdempotency",
        "requireRollback",
        "reconciliationMode",
        "allowDropTableInRollback"
      ],
      "properties": {
        "engine": {
          "const": "postgresql"
        },
        "majorVersion": {
          "const": 16
        },
        "disposableDatabaseName": {
          "const": "clover_data"
        },
        "allowedTablePrefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*_$"
          }
        },
        "baselineSqlPath": {
          "type": "string",
          "minLength": 1
        },
        "seedSqlPath": {
          "type": "string",
          "minLength": 1
        },
        "forwardSqlPath": {
          "type": "string",
          "minLength": 1
        },
        "assertionsSqlPath": {
          "type": "string",
          "minLength": 1
        },
        "reconciliationSqlPath": {
          "type": "string",
          "minLength": 1
        },
        "rollbackSqlPath": {
          "type": "string",
          "minLength": 1
        },
        "postRollbackAssertionsSqlPath": {
          "type": "string",
          "minLength": 1
        },
        "requireForwardIdempotency": {
          "const": true
        },
        "requireRollback": {
          "const": true
        },
        "reconciliationMode": {
          "const": "preserve"
        },
        "allowDropTableInRollback": {
          "const": false
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionDatabaseReadApproved",
        "productionDatabaseWriteApproved",
        "productionMigrationApproved",
        "productionBackupOrRestoreApproved",
        "mergeApproved",
        "productionDeploymentApproved",
        "domainOrDnsChangeApproved",
        "secretChangeApproved",
        "externalMessageApproved",
        "purchaseApproved"
      ],
      "properties": {
        "productionDatabaseReadApproved": {
          "const": false
        },
        "productionDatabaseWriteApproved": {
          "const": false
        },
        "productionMigrationApproved": {
          "const": false
        },
        "productionBackupOrRestoreApproved": {
          "const": false
        },
        "mergeApproved": {
          "const": false
        },
        "productionDeploymentApproved": {
          "const": false
        },
        "domainOrDnsChangeApproved": {
          "const": false
        },
        "secretChangeApproved": {
          "const": false
        },
        "externalMessageApproved": {
          "const": false
        },
        "purchaseApproved": {
          "const": false
        }
      }
    }
  }
}
