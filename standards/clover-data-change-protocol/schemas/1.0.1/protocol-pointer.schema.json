{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloverapps.ai/schemas/clover-data-protocol-pointer-1.0.1-candidate.json",
  "title": "Clover Data Change Protocol Pointer with 1.0.1 Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentType",
    "schemaVersion",
    "repository",
    "canonicalDirectory",
    "currentVersion",
    "currentDocument",
    "status",
    "preservedLocalDate",
    "timezone",
    "verifiedThroughUtc",
    "validatedReusableRuntimeCommit",
    "validatedStandardWorkflowRunId",
    "validatedPilotWorkflowRunId",
    "candidateVersion",
    "candidateDocument",
    "candidateStatus",
    "candidateBaseCommit",
    "candidatePreparedLocalDate",
    "candidateValidation",
    "standingProductionAuthority",
    "ownerApprovalRequiredForProductionDataAccess",
    "defaultAutomationMode",
    "reusableWorkflow",
    "schemasDirectory",
    "currentRuntimeDirectory",
    "candidateRuntimeDirectory",
    "candidateSchemasDirectory",
    "candidatePolicyTemplate",
    "readFirst"
  ],
  "properties": {
    "documentType": { "const": "clover-data-change-protocol-pointer" },
    "schemaVersion": { "const": "1.1" },
    "repository": { "const": "chrisdortch/first" },
    "canonicalDirectory": { "const": "standards/clover-data-change-protocol" },
    "currentVersion": { "const": "1.0.0" },
    "currentDocument": { "const": "standards/clover-data-change-protocol/versions/1.0.0/CLOVER_DATA_CHANGE_PROTOCOL.md" },
    "status": { "const": "disposable-pilot-validated" },
    "preservedLocalDate": { "const": "2026-08-16" },
    "timezone": { "const": "America/Chicago" },
    "verifiedThroughUtc": { "type": "string", "minLength": 1 },
    "validatedReusableRuntimeCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "validatedStandardWorkflowRunId": { "type": "integer", "minimum": 1 },
    "validatedPilotWorkflowRunId": { "type": "integer", "minimum": 1 },
    "candidateVersion": { "const": "1.0.1" },
    "candidateDocument": { "const": "standards/clover-data-change-protocol/versions/1.0.1/CLOVER_DATA_CHANGE_PROTOCOL.md" },
    "candidateStatus": { "const": "security-hardening-candidate-unvalidated" },
    "candidateBaseCommit": { "const": "7d5d15bc2bc39a74725c9cfd6827bfe61dbb65ed" },
    "candidatePreparedLocalDate": { "const": "2026-08-19" },
    "candidateValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactHeadCiPassed", "standardWorkflowRunId", "disposablePilotPassed", "pilotWorkflowRunId"],
      "properties": {
        "exactHeadCiPassed": { "const": false },
        "standardWorkflowRunId": { "type": "null" },
        "disposablePilotPassed": { "const": false },
        "pilotWorkflowRunId": { "type": "null" }
      }
    },
    "standingProductionAuthority": { "const": false },
    "ownerApprovalRequiredForProductionDataAccess": { "const": true },
    "defaultAutomationMode": { "const": "disposable-database-only" },
    "reusableWorkflow": { "const": ".github/workflows/clover-data-preview-v1.yml" },
    "schemasDirectory": { "const": "standards/clover-data-change-protocol/schemas" },
    "currentRuntimeDirectory": { "const": "standards/clover-data-change-protocol/runtime/v1.0.0" },
    "candidateRuntimeDirectory": { "const": "standards/clover-data-change-protocol/runtime/v1.0.1" },
    "candidateSchemasDirectory": { "const": "standards/clover-data-change-protocol/schemas/1.0.1" },
    "candidatePolicyTemplate": { "const": "standards/clover-data-change-protocol/templates/data-change-policy.v1.0.1.template.json" },
    "readFirst": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
