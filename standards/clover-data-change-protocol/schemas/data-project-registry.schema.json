{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloverapps.ai/schemas/clover-data-project-registry-1.0.0.json",
  "title": "Clover Data Project Registry 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "updatedAt",
    "validatedReusableRuntimeCommit",
    "projects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "protocolVersion": {
      "const": "1.0.0"
    },
    "updatedAt": {
      "type": "string"
    },
    "validatedReusableRuntimeCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "projectId",
          "title",
          "repository",
          "adoptionStatus",
          "productionBranch",
          "productionDatabaseAccessed",
          "authority"
        ],
        "properties": {
          "projectId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "repository": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          },
          "adoptionStatus": {
            "enum": [
              "pilot-pending",
              "disposable-pilot-validated-not-merged",
              "not-enrolled",
              "blocked"
            ]
          },
          "productionBranch": {
            "type": "string"
          },
          "productionHeadAtVerification": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "productionDatabaseAccessed": {
            "const": false
          },
          "authority": {
            "type": "object",
            "required": [
              "productionDatabaseReadApproved",
              "productionDatabaseWriteApproved",
              "productionMigrationApproved",
              "productionRestoreApproved"
            ],
            "properties": {
              "productionDatabaseReadApproved": {
                "const": false
              },
              "productionDatabaseWriteApproved": {
                "const": false
              },
              "productionMigrationApproved": {
                "const": false
              },
              "productionRestoreApproved": {
                "const": false
              }
            }
          }
        }
      }
    }
  }
}
