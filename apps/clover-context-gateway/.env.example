PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
ALLOWED_ORIGIN=*
MAX_BODY_BYTES=65536

# auto = use the monorepo root when available; otherwise read the public canonical repo from GitHub.
CONTEXT_SOURCE_MODE=auto
CONTEXT_SOURCE_REF=main
CONTEXT_CACHE_TTL_MS=300000

# Optional local override. In the monorepo, the app automatically resolves ../..
CONTEXT_ROOT=
CONTEXT_SOURCE_COMMIT=

# Optional future rate-limit/auth improvement for public GitHub reads. Never commit a value.
CONTEXT_GITHUB_TOKEN=
