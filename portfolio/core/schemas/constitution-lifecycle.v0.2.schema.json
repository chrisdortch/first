{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloverapps.ai/schemas/constitution-lifecycle.v0.2.schema.json",
  "title": "Clover Constitution Lifecycle Registry Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "status", "precedence", "currentVersion", "versions", "allowedLifecycleStates", "activationRequirements", "authorityGrantedByCandidate"],
  "properties": {
    "documentType": { "const": "clover-constitution-lifecycle-registry-candidate" },
    "schemaVersion": { "const": "0.2" },
    "status": { "const": "draft-unratified" },
    "precedence": { "type": "string", "minLength": 1 },
    "currentVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "path", "sha256", "lifecycleStatus", "current", "ownerDecision", "authenticationAssurance", "canonicalRepositoryStatus", "runtimeEnforcementStatus", "ratificationEvidence"],
        "properties": {
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "lifecycleStatus": { "enum": ["draft", "ratified-inactive", "ratified-active", "suspended", "superseded", "repealed"] },
          "current": { "type": "boolean" },
          "ownerDecision": { "type": ["string", "null"] },
          "authenticationAssurance": { "type": "string", "minLength": 1 },
          "canonicalRepositoryStatus": { "type": "string", "minLength": 1 },
          "runtimeEnforcementStatus": { "type": "string", "minLength": 1 },
          "ratificationEvidence": { "type": ["string", "null"] }
        }
      }
    },
    "allowedLifecycleStates": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string" } },
    "activationRequirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "authorityGrantedByCandidate": { "type": "array", "maxItems": 0 }
  }
}
