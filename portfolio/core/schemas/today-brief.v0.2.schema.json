{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloverapps.ai/schemas/today-brief.v0.2.schema.json",
  "title": "Clover Today Brief 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "synthetic", "asOf", "basedOnCapsuleHash", "projects", "unknowns", "limitations", "briefHash"],
  "properties": {
    "documentType": { "const": "clover-today-brief" },
    "schemaVersion": { "const": "0.2" },
    "synthetic": { "const": true },
    "asOf": { "type": "string", "format": "date-time" },
    "basedOnCapsuleHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projects": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "status", "nextMilestone", "freshness", "sourceContentHash"],
        "properties": {
          "projectId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
          "status": { "$ref": "minimum-context-capsule.v0.2.schema.json#/$defs/importedFact" },
          "nextMilestone": { "$ref": "minimum-context-capsule.v0.2.schema.json#/$defs/importedFact" },
          "freshness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observedAt", "asOf"],
            "properties": {
              "observedAt": { "type": "string", "format": "date-time" },
              "asOf": { "type": "string", "format": "date-time" }
            }
          },
          "sourceContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "briefHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
