{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloverapps.ai/schemas/launch-studio/0.1.0/launch-session-event.schema.json",
  "title": "Append-only Launch Session event",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "eventId", "idempotencyKey", "sessionId", "workspaceId", "projectId", "sequence", "expectedSessionVersion", "resultingSessionVersion", "predecessorEventHash", "recordedAt", "eventType", "fromState", "toState", "actor", "ownerPrincipal", "conciseStatus", "materialDelta", "evidence", "changedPaths", "testCounts", "failureSignature", "repairLoopCount", "knownUnknowns", "nextOwnerDecision", "ownerDecision", "ownerDecisionBinding", "authorityReference", "approvedBuildCharter", "executorWorkOrder", "executorWorkOrderBinding", "modelResolution", "sessionBudgetId", "sessionBudgetHash", "sessionBudget", "budgetDelta", "synthetic", "externalEffects", "consequentialAuthorityGranted", "eventHash"],
  "properties": {
    "documentType": {"const": "clover-launch-session-event"}, "schemaVersion": {"const": "0.1.0"}, "eventId": {"$ref": "common.schema.json#/$defs/id"}, "idempotencyKey": {"$ref": "common.schema.json#/$defs/id"},
    "sessionId": {"$ref": "common.schema.json#/$defs/id"}, "workspaceId": {"$ref": "common.schema.json#/$defs/id"}, "projectId": {"$ref": "common.schema.json#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 1}, "expectedSessionVersion": {"type": "integer", "minimum": 0}, "resultingSessionVersion": {"type": "integer", "minimum": 1},
    "predecessorEventHash": {"$ref": "common.schema.json#/$defs/nullableHash"}, "recordedAt": {"$ref": "common.schema.json#/$defs/timestamp"}, "eventType": {"enum": ["session_created", "owner_event_captured", "understanding_proposed", "understanding_confirmed", "context_loaded", "impact_scan_completed", "charter_proposed", "decision_required", "authority_proposed", "worktree_created", "build_started", "source_delta_recorded", "tests_started", "tests_completed", "failure_detected", "diagnosis_summary", "repair_loop_started", "repair_loop_completed", "preview_created", "preview_verified", "owner_feedback_received", "revision_completed", "receipt_created", "model_resolved", "session_held", "session_completed"]},
    "fromState": {"oneOf": [{"$ref": "common.schema.json#/$defs/sessionState"}, {"type": "null"}]}, "toState": {"$ref": "common.schema.json#/$defs/sessionState"}, "actor": {"$ref": "common.schema.json#/$defs/actor"}, "ownerPrincipal": {"$ref": "common.schema.json#/$defs/actor"}, "conciseStatus": {"type": "string", "minLength": 1},
    "materialDelta": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence"}}, "changedPaths": {"$ref": "common.schema.json#/$defs/stringArray"},
    "testCounts": {"type": ["object", "null"], "additionalProperties": false, "required": ["passed", "failed", "skipped"], "properties": {"passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0}}},
    "failureSignature": {"type": ["string", "null"]}, "repairLoopCount": {"type": "integer", "minimum": 0}, "knownUnknowns": {"$ref": "common.schema.json#/$defs/stringArray"}, "nextOwnerDecision": {"type": ["string", "null"]},
    "ownerDecision": {"type": ["string", "null"]},
    "ownerDecisionBinding": {"oneOf": [{"$ref": "#/$defs/ownerDecisionBinding"}, {"type": "null"}]},
    "authorityReference": {"oneOf": [{"$ref": "authority-reference.schema.json"}, {"type": "null"}]},
    "approvedBuildCharter": {"oneOf": [{"$ref": "build-charter.schema.json"}, {"type": "null"}]},
    "executorWorkOrder": {"oneOf": [{"$ref": "executor-work-order.schema.json"}, {"type": "null"}]},
    "executorWorkOrderBinding": {"type": ["object", "null"], "additionalProperties": false, "required": ["recordId", "recordHash", "repository", "baseCommit", "allowedPaths", "allowedPathsHash", "prohibitedEffects", "prohibitedEffectsHash", "modelCapabilityPolicy", "approvedCharterId", "approvedCharterHash", "handoffAuthorityReferenceId", "handoffAuthorityReferenceHash", "contextPackHash", "impactScanHash", "sessionUsageCeilingId", "deliverablesHash", "testPlanHash", "progressEventContractHash", "stopConditionsHash", "repairLoopBudget"], "properties": {"recordId": {"$ref": "common.schema.json#/$defs/id"}, "recordHash": {"$ref": "common.schema.json#/$defs/hash"}, "repository": {"type": "string", "minLength": 1}, "baseCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "allowedPaths": {"$ref": "common.schema.json#/$defs/stringArray"}, "allowedPathsHash": {"$ref": "common.schema.json#/$defs/hash"}, "prohibitedEffects": {"$ref": "common.schema.json#/$defs/stringArray"}, "prohibitedEffectsHash": {"$ref": "common.schema.json#/$defs/hash"}, "modelCapabilityPolicy": {"type": "array", "uniqueItems": true, "items": {"enum": ["high-reasoning", "implementation", "mechanical", "deterministic"]}}, "approvedCharterId": {"$ref": "common.schema.json#/$defs/id"}, "approvedCharterHash": {"$ref": "common.schema.json#/$defs/hash"}, "handoffAuthorityReferenceId": {"$ref": "common.schema.json#/$defs/id"}, "handoffAuthorityReferenceHash": {"$ref": "common.schema.json#/$defs/hash"}, "contextPackHash": {"$ref": "common.schema.json#/$defs/hash"}, "impactScanHash": {"$ref": "common.schema.json#/$defs/hash"}, "sessionUsageCeilingId": {"$ref": "common.schema.json#/$defs/id"}, "deliverablesHash": {"$ref": "common.schema.json#/$defs/hash"}, "testPlanHash": {"$ref": "common.schema.json#/$defs/hash"}, "progressEventContractHash": {"$ref": "common.schema.json#/$defs/hash"}, "stopConditionsHash": {"$ref": "common.schema.json#/$defs/hash"}, "repairLoopBudget": {"type": "integer", "minimum": 0}}},
    "modelResolution": {"oneOf": [{"$ref": "#/$defs/modelResolution"}, {"type": "null"}]},
    "sessionBudgetId": {"$ref": "common.schema.json#/$defs/id"}, "sessionBudgetHash": {"$ref": "common.schema.json#/$defs/hash"}, "sessionBudget": {"$ref": "session-budget.schema.json"},
    "budgetDelta": {"type": "object", "additionalProperties": false, "required": ["modelCalls", "implementationAgents", "ciRuns", "previews", "elapsedMinutes", "providerUsage", "purchaseUsd"], "properties": {"modelCalls": {"type": "integer", "minimum": 0}, "implementationAgents": {"type": "integer", "minimum": 0}, "ciRuns": {"type": "integer", "minimum": 0}, "previews": {"type": "integer", "minimum": 0}, "elapsedMinutes": {"type": "integer", "minimum": 0}, "providerUsage": {"type": "number", "minimum": 0}, "purchaseUsd": {"type": "number", "minimum": 0}}},
    "synthetic": {"type": "boolean"}, "externalEffects": {"$ref": "common.schema.json#/$defs/externalEffects"}, "consequentialAuthorityGranted": {"const": false}, "eventHash": {"$ref": "common.schema.json#/$defs/hash"}
  },
  "$defs": {
    "ownerDecisionBinding": {"type": "object", "additionalProperties": false, "required": ["decisionId", "statement", "boundRecordId", "boundRecordHash", "decidedAt", "actor", "synthetic", "nonAuthorizing"], "properties": {"decisionId": {"$ref": "common.schema.json#/$defs/id"}, "statement": {"enum": ["APPROVE BUILD CHARTER", "ACCEPT PREVIEW CANDIDATE", "APPROVE MERGE", "APPROVE PRODUCTION"]}, "boundRecordId": {"$ref": "common.schema.json#/$defs/id"}, "boundRecordHash": {"$ref": "common.schema.json#/$defs/hash"}, "decidedAt": {"$ref": "common.schema.json#/$defs/timestamp"}, "actor": {"$ref": "common.schema.json#/$defs/actor"}, "synthetic": {"type": "boolean"}, "nonAuthorizing": {"type": "boolean"}}},
    "modelResolution": {"type": "object", "additionalProperties": false, "required": ["capabilityClass", "resolvedModelId", "resolvedAt"], "properties": {"capabilityClass": {"enum": ["high-reasoning", "implementation", "mechanical", "deterministic"]}, "resolvedModelId": {"type": "string", "minLength": 1}, "resolvedAt": {"$ref": "common.schema.json#/$defs/timestamp"}}}
  },
  "allOf": [
    {"if": {"properties": {"synthetic": {"const": true}}}, "then": {"properties": {"externalEffects": {"type": "array", "maxItems": 0}}}},
    {"if": {"properties": {"eventType": {"const": "model_resolved"}}}, "then": {"properties": {"modelResolution": {"$ref": "#/$defs/modelResolution"}}}, "else": {"properties": {"modelResolution": {"const": null}}}},
    {"if": {"properties": {"ownerDecision": {"type": "string"}}}, "then": {"properties": {"ownerDecisionBinding": {"$ref": "#/$defs/ownerDecisionBinding"}}}, "else": {"properties": {"ownerDecisionBinding": {"const": null}}}},
    {"if": {"properties": {"toState": {"const": "charter_approved"}}}, "then": {"properties": {"approvedBuildCharter": {"$ref": "build-charter.schema.json"}}}, "else": {"properties": {"approvedBuildCharter": {"const": null}}}}
  ]
}
