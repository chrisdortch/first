{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloverapps.ai/schemas/launch-studio/0.1.0/authority-reference.schema.json",
  "title": "Clover Handoff authority reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "referenceId", "authoritySystem", "actionEnvelopeId", "actionEnvelopePath", "actionEnvelopeHash", "branchCapsuleId", "branchCapsulePath", "branchCapsuleHash", "lifecycleIndexPath", "lifecycleIndexHash", "approvalAttestationId", "approvalAttestationPath", "approvalAttestationHash", "executionReceiptId", "executionReceiptPath", "executionReceiptHash", "independentReviewId", "independentReviewPath", "independentReviewHash", "lifecycle", "scope", "approvalRail", "boundRecordType", "boundRecordId", "boundRecordHash", "boundSessionId", "boundProjectId", "boundRepository", "boundBaseCommit", "boundAllowedPathsHash", "boundProhibitedEffectsHash", "createdAt", "expiresAt", "nonAuthorizing", "independentAuthoritySystemCreated", "synthetic", "consequentialAuthorityGranted"],
  "properties": {
    "documentType": {"const": "clover-launch-authority-reference"},
    "schemaVersion": {"const": "0.1.0"},
    "referenceId": {"$ref": "common.schema.json#/$defs/id"},
    "authoritySystem": {"const": "clover-handoff"},
    "actionEnvelopeId": {"$ref": "common.schema.json#/$defs/id"},
    "actionEnvelopePath": {"type": "string", "pattern": "^portfolio/core/handoff/"},
    "actionEnvelopeHash": {"$ref": "common.schema.json#/$defs/hash"},
    "branchCapsuleId": {"$ref": "common.schema.json#/$defs/id"},
    "branchCapsulePath": {"type": "string", "pattern": "^portfolio/core/handoff/"},
    "branchCapsuleHash": {"$ref": "common.schema.json#/$defs/hash"},
    "lifecycleIndexPath": {"type": "string", "pattern": "^portfolio/core/handoff/"},
    "lifecycleIndexHash": {"$ref": "common.schema.json#/$defs/hash"},
    "approvalAttestationId": {"type": ["string", "null"]},
    "approvalAttestationPath": {"type": ["string", "null"]},
    "approvalAttestationHash": {"$ref": "common.schema.json#/$defs/nullableHash"},
    "executionReceiptId": {"type": ["string", "null"]},
    "executionReceiptPath": {"type": ["string", "null"]},
    "executionReceiptHash": {"$ref": "common.schema.json#/$defs/nullableHash"},
    "independentReviewId": {"type": ["string", "null"]},
    "independentReviewPath": {"type": ["string", "null"]},
    "independentReviewHash": {"$ref": "common.schema.json#/$defs/nullableHash"},
    "lifecycle": {"enum": ["proposed", "approved", "consumed", "expired", "revoked"]},
    "scope": {"enum": ["build-charter", "preview-candidate", "merge", "production", "executor-work-order"]},
    "approvalRail": {"enum": ["APPROVE_BUILD_CHARTER", "ACCEPT_PREVIEW_CANDIDATE", "APPROVE_MERGE", "APPROVE_PRODUCTION"]},
    "boundRecordType": {"enum": ["build-charter", "preview-receipt", "merge-candidate", "production-candidate", "executor-work-order"]},
    "boundRecordId": {"$ref": "common.schema.json#/$defs/id"},
    "boundRecordHash": {"$ref": "common.schema.json#/$defs/hash"},
    "boundSessionId": {"$ref": "common.schema.json#/$defs/id"},
    "boundProjectId": {"$ref": "common.schema.json#/$defs/id"},
    "boundRepository": {"type": ["string", "null"]},
    "boundBaseCommit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
    "boundAllowedPathsHash": {"$ref": "common.schema.json#/$defs/hash"},
    "boundProhibitedEffectsHash": {"$ref": "common.schema.json#/$defs/hash"},
    "createdAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "expiresAt": {"$ref": "common.schema.json#/$defs/nullableTimestamp"},
    "nonAuthorizing": {"type": "boolean"},
    "independentAuthoritySystemCreated": {"const": false},
    "synthetic": {"type": "boolean"},
    "consequentialAuthorityGranted": {"const": false}
  },
  "allOf":[
    {"if":{"properties":{"lifecycle":{"const":"proposed"}}},"then":{"properties":{"approvalAttestationId":{"const":null},"approvalAttestationPath":{"const":null},"approvalAttestationHash":{"const":null},"executionReceiptId":{"const":null},"executionReceiptPath":{"const":null},"executionReceiptHash":{"const":null},"nonAuthorizing":{"const":true}}}},
    {"if":{"properties":{"lifecycle":{"const":"approved"}}},"then":{"properties":{"approvalAttestationId":{"type":"string","minLength":1},"approvalAttestationPath":{"type":"string","minLength":1},"approvalAttestationHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"executionReceiptId":{"const":null},"executionReceiptPath":{"const":null},"executionReceiptHash":{"const":null},"nonAuthorizing":{"const":false}}}},
    {"if":{"properties":{"lifecycle":{"const":"consumed"}}},"then":{"properties":{"approvalAttestationId":{"type":"string","minLength":1},"approvalAttestationPath":{"type":"string","minLength":1},"approvalAttestationHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"executionReceiptId":{"type":"string","minLength":1},"executionReceiptPath":{"type":"string","minLength":1},"executionReceiptHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"nonAuthorizing":{"const":true}}}},
    {"if":{"properties":{"lifecycle":{"enum":["expired","revoked"]}}},"then":{"properties":{"nonAuthorizing":{"const":true}}}}
  ]
}
