{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloverapps.ai/schemas/launch-studio/0.1.0/shared-project-delta.schema.json","title":"Permissioned shared Project Delta","type":"object","additionalProperties":false,
  "required":["documentType","schemaVersion","recordId","workspaceId","projectId","proposerParticipantId","basis","classification","statement","audience","purpose","retention","attribution","ownership","consentReferences","requiredApprovalReferences","correctionOf","supersedes","revocationReference","promotionStatus","personalChatGptMemoryIncluded","synthetic","consequentialAuthorityGranted"],
  "properties":{"documentType":{"const":"clover-shared-project-delta"},"schemaVersion":{"const":"0.1.0"},"recordId":{"$ref":"common.schema.json#/$defs/id"},"workspaceId":{"$ref":"common.schema.json#/$defs/id"},"projectId":{"$ref":"common.schema.json#/$defs/id"},"proposerParticipantId":{"$ref":"common.schema.json#/$defs/id"},"basis":{"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/sourcePointer"}},"classification":{"$ref":"common.schema.json#/$defs/truthClassification"},"statement":{"type":"string","minLength":1},"audience":{"$ref":"common.schema.json#/$defs/visibility"},"purpose":{"type":"string","minLength":1},"retention":{"type":"string","minLength":1},"attribution":{"type":"string","minLength":1},"ownership":{"type":"string","minLength":1},"consentReferences":{"type":"array","items":{"$ref":"common.schema.json#/$defs/recordReference"},"uniqueItems":true},"requiredApprovalReferences":{"$ref":"common.schema.json#/$defs/idArray"},"correctionOf":{"type":["string","null"]},"supersedes":{"type":["string","null"]},"revocationReference":{"type":["string","null"]},"promotionStatus":{"enum":["proposed","approved","rejected","superseded","revoked"]},"personalChatGptMemoryIncluded":{"const":false},"synthetic":{"type":"boolean"},"consequentialAuthorityGranted":{"const":false}},
  "allOf":[
    {"if":{"properties":{"promotionStatus":{"const":"approved"}}},"then":{"properties":{"consentReferences":{"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/recordReference"},"uniqueItems":true},"requiredApprovalReferences":{"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/id"},"uniqueItems":true}}}},
    {"if":{"properties":{"promotionStatus":{"const":"superseded"}}},"then":{"properties":{"supersedes":{"type":"string","minLength":1}}}},
    {"if":{"properties":{"promotionStatus":{"const":"revoked"}}},"then":{"properties":{"revocationReference":{"type":"string","minLength":1}}}}
  ]
