{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloverapps.ai/schemas/launch-studio/0.1.0/fruit-observation.schema.json","title":"Predicted or observed fruit","type":"object","additionalProperties":false,
  "required":["documentType","schemaVersion","recordId","sessionId","kind","statement","classification","metric","predictedValue","observedValue","observedAt","source","causalClaim","causalSupport","privacyClass","visibility","synthetic","consequentialAuthorityGranted"],
  "properties":{"documentType":{"const":"clover-fruit-observation"},"schemaVersion":{"const":"0.1.0"},"recordId":{"$ref":"common.schema.json#/$defs/id"},"sessionId":{"$ref":"common.schema.json#/$defs/id"},"kind":{"enum":["predicted","observed"]},"statement":{"type":"string","minLength":1},"classification":{"enum":["forecast","conditional-potential","observed-outcome"]},"metric":{"type":"string","minLength":1},"predictedValue":{"type":["number","string","null"]},"observedValue":{"type":["number","string","null"]},"observedAt":{"$ref":"common.schema.json#/$defs/nullableTimestamp"},"source":{"oneOf":[{"$ref":"common.schema.json#/$defs/sourcePointer"},{"type":"null"}]},"causalClaim":{"type":["string","null"]},"causalSupport":{"type":"array","items":{"$ref":"common.schema.json#/$defs/evidence"}},"privacyClass":{"$ref":"common.schema.json#/$defs/privacyClass"},"visibility":{"$ref":"common.schema.json#/$defs/visibility"},"roleVisibilityBinding":{"$ref":"common.schema.json#/$defs/roleVisibilityBinding"},"synthetic":{"type":"boolean"},"consequentialAuthorityGranted":{"const":false}},
  "allOf":[
    {"if":{"properties":{"kind":{"const":"predicted"}}},"then":{"properties":{"classification":{"enum":["forecast","conditional-potential"]},"observedValue":{"const":null},"observedAt":{"const":null},"source":{"const":null}}}},
    {"if":{"properties":{"kind":{"const":"observed"}}},"then":{"properties":{"classification":{"const":"observed-outcome"},"observedValue":{"type":["number","string"]},"observedAt":{"type":"string"},"source":{"$ref":"common.schema.json#/$defs/sourcePointer"}}}}
  ]
}
